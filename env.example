# ─── Gemini (Browser Agent LLM) ───────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_key_here

# Model to use for the browser agent.
# Free-tier safe choices (no billing required):
#   gemini-2.0-flash   → 15 req/min, 1500 req/day  (RECOMMENDED)
#   gemini-1.5-flash   → 15 req/min, 1500 req/day
# DO NOT use gemini-1.5-pro or gemini-3.1-pro on free tier — quota is near 0.
GEMINI_MODEL=gemini-2.0-flash

# ─── Groq (Task Planner LLM — free) ──────────────────────────────────────────
GROQ_API_KEY=your_groq_key_here

# ─── Panel ────────────────────────────────────────────────────────────────────
PANEL_URL=http://localhost:5000

# ─── Slack (optional) ────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here
